# Analyzer implementation. v1 ships with the mock analyzer only.
ANALYZER=mock

# Upload limit in megabytes.
MAX_UPLOAD_MB=15

# Simulated analysis delay so the UI loading state is visible.
MOCK_DELAY_SECONDS=1.4

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
